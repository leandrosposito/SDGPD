# ============================================================
# Variables de entorno — copiar a .env.local para desarrollo local
# (no committear .env.local: ya cubierto por *.local en .gitignore).
# Todas las leidas por Vite deben empezar con VITE_ (convencion de
# Vite: cualquier otro prefijo no llega a import.meta.env).
# ============================================================

# 'mock' (default) resuelve httpClient contra services/mock/* con
# latencia simulada. 'http' hace fetch() real contra VITE_API_BASE_URL.
# Cambiar esto es, a proposito, el UNICO paso para migrar de mock a un
# backend real — ningun call-site de ningun service.ts deberia cambiar.
VITE_API_MODE=mock

# Base URL del backend real. Solo se usa cuando VITE_API_MODE=http.
VITE_API_BASE_URL=

# Latencia simulada en milisegundos para cada peticion en modo mock
# (default 300). Subirla (ej. 3000) sirve para ejercer visualmente los
# estados de carga (LoadingState/FetchingOverlay) sin esperar a que
# exista un backend lento de verdad.
VITE_MOCK_LATENCY_MS=300

# Probabilidad (0 a 1) de que una peticion en modo mock falle con un
# error simulado de servidor (503, reintentable). Default 0 (nunca
# falla). Con 1, TODAS las peticiones fallan siempre — util para
# ejercer el camino de ErrorState + reintentos + backoff, que sin esto
# nunca se prueba ni una vez (ver AUDITORIA_ESCALABILIDAD.md, hallazgo #7).
VITE_MOCK_FAILURE_RATE=0

# 'true' hace que httpClient.ts registre en consola cada evento de
# cada peticion: start / resolved / retry / cancelled / error, con un
# id corto compartido entre los reintentos de un mismo llamado.
# Default false (no ensucia la consola en desarrollo normal). Es la
# forma de verificar timeout/reintentos/cancelacion sin depender de la
# pestaña Network — en modo mock (VITE_API_MODE=mock) nunca se llama a
# fetch(), asi que Network no muestra nada por definicion.
VITE_API_DEBUG=false
