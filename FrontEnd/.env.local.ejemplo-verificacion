# ============================================================
# Escenarios de verificacion manual — Tandas 0 y 1 (contencion de
# errores + capa api/httpClient + piloto suppliers).
#
# COMO USAR: copiar el bloque del escenario que quieras probar a un
# archivo .env.local (crearlo si no existe, en esta misma carpeta
# FrontEnd/) y REINICIAR `npm run dev` — Vite lee las variables de
# entorno una sola vez al arrancar, no en caliente. Este archivo en si
# NO lo lee Vite (el nombre no matchea .env/.env.local/.env.[modo]),
# es solo una referencia para copiar de aca.
#
# No pisa ningun .env.local existente: si ya tenes uno con otra config,
# guardalo aparte antes de pegar un bloque de aca.
# ============================================================

# ------------------------------------------------------------
# ESCENARIO A — Normal (default de la app si no existe .env.local)
# Latencia baja, sin fallos, sin logs de httpClient.
# ------------------------------------------------------------
# VITE_API_MODE=mock
# VITE_MOCK_LATENCY_MS=300
# VITE_MOCK_FAILURE_RATE=0
# VITE_API_DEBUG=false

# ------------------------------------------------------------
# ESCENARIO B — Latencia alta (checklist punto 7: LoadingState visible)
# 3 segundos por peticion — tiempo de sobra para ver LoadingState /
# FetchingOverlay antes de que resuelva.
# ------------------------------------------------------------
# VITE_API_MODE=mock
# VITE_MOCK_LATENCY_MS=3000
# VITE_MOCK_FAILURE_RATE=0
# VITE_API_DEBUG=true

# ------------------------------------------------------------
# ESCENARIO C — Fallo forzado (checklist puntos 8 y 9: ErrorState +
# reintento, y ver los 2 reintentos automaticos con backoff por consola)
# TODAS las peticiones fallan siempre (503 simulado) — httpClient
# reintenta 2 veces con backoff (300ms, 600ms) y recien ahi se rinde.
# VITE_API_DEBUG=true para ver "start/retry/retry/error" en consola.
# ------------------------------------------------------------
# VITE_API_MODE=mock
# VITE_MOCK_LATENCY_MS=300
# VITE_MOCK_FAILURE_RATE=1
# VITE_API_DEBUG=true

# ------------------------------------------------------------
# ESCENARIO D — Cancelacion (checklist punto 12: tipear rapido cancela
# requests viejos). Misma latencia que el escenario B (3000ms) para que
# haya tiempo de ver "start" de una tecla y "cancelled" de la anterior
# antes de que ninguna resuelva, en vez de que ambas terminen tan
# rapido que sea dificil distinguir el orden en consola.
# ------------------------------------------------------------
# VITE_API_MODE=mock
# VITE_MOCK_LATENCY_MS=3000
# VITE_MOCK_FAILURE_RATE=0
# VITE_API_DEBUG=true
