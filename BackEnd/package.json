{
  "name": "@sdgpd/backend",
  "version": "0.0.0",
  "private": true,
  "description": "Backend de SDGPD: NestJS + PostgreSQL con RLS (ADR-BE-001, ADR-BE-002).",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "npm run build -w @sdgpd/contracts && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "db:setup": "node --env-file-if-exists=.env scripts/db/setup.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/db/migrate.ts",
    "db:sql": "node --env-file-if-exists=.env scripts/db/sql.ts",
    "db:seed-dev": "npm run build -w @sdgpd/contracts && node --env-file-if-exists=.env scripts/db/seed-dev.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@node-rs/argon2": "2.2.2",
    "@sdgpd/contracts": "0.0.0",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "14.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.1.2",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
