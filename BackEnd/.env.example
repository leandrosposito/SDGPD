# Plantilla de BackEnd/.env (el .env real no se versiona). Ver docs/SETUP_SUPABASE.md.
# Ningún valor de acá es real.

# --- Aplicación (validadas al arrancar: si falta una, el backend no levanta) ---
PORT=3000
# Rol sdgpd_app. La escribe scripts/db/setup.ts.
DATABASE_URL=postgresql://sdgpd_app.<project-ref>:<password>@<pooler-host>:5432/postgres
# Ruta al certificado CA de Supabase. El SSL siempre se verifica contra este archivo.
DATABASE_CA_CERT=<ruta-al-certificado-ca>
# Clave HS256 del access token (32 bytes en base64url). La genera `db:setup` (o `db:setup -- --secrets-only`).
JWT_SECRET=<la-genera-db-setup>

# --- Seed de desarrollo (solo sdgpd). Los genera `db:seed-dev` la primera vez. ---
SEED_EMPRESA_ID=<uuid>
SEED_ADMIN_EMAIL=<email-generado>
SEED_ADMIN_PASSWORD=<contraseña-generada>
SEED_EMPRESA_B_ID=<uuid>
SEED_ADMIN_B_EMAIL=<email-generado>
SEED_ADMIN_B_PASSWORD=<contraseña-generada>

# --- Tests (rol sdgpd_app_test, schema sdgpd_test). La escribe scripts/db/setup.ts. ---
DATABASE_URL_TEST=postgresql://sdgpd_app_test.<project-ref>:<password>@<pooler-host>:5432/postgres

# --- Migraciones (rol sdgpd_migrator). La escribe scripts/db/setup.ts. ---
DATABASE_URL_MIGRATOR=postgresql://sdgpd_migrator.<project-ref>:<password>@<pooler-host>:5432/postgres

# --- Setup (solo scripts/db/setup.ts) ---
# Host del session pooler (puerto 5432, no el 6543 del transaction pooler).
DB_HOST=<pooler-host>
DB_PORT=5432
DB_NAME=postgres
# Con el pooler, los usuarios son <rol>.<project-ref>. Sin pooler, dejarla vacía.
SUPABASE_PROJECT_REF=<project-ref>
# La contraseña de postgres NO va acá: se lee de la variable de entorno SUPABASE_DB_PASSWORD.
